# No key is required for the clearly labelled demonstration provider.
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.14.0

# Optional second-model check: HTTPS OpenAI-compatible Chat Completions
# with strict JSON Schema output. These values stay on the server.
VERIFIER_API_KEY=
VERIFIER_BASE_URL=
VERIFIER_MODEL=

# Approximate cost planning only. Set prices to your actual provider contract.
# This does not enforce a billing cap; max_requests bounds request attempts.
JEV_INPUT_PRICE_PER_MILLION=0.042
VERIFIER_PRICE_PER_MILLION=0

# Default is a trusted local workspace, reachable only on localhost in Compose.
# For shared hosting, set unique random tokens (24+ characters each), TLS,
# explicit allowed hosts, and secure cookies. Never put keys in the browser.
STUDIO_ACCESS_TOKENS={}
STUDIO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],web
STUDIO_SECURE_COOKIES=false

# Local Compose database only; use a URL-safe password if you change this.
POSTGRES_PASSWORD=studio-local-development

# Local Python mode only. Compose sets these itself.
# STUDIO_DATA_DIR=data
# DATABASE_URL=sqlite:///data/studio.sqlite3
